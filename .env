# Личные настройки: свой аккаунт, логи, таймауты.
# Общее для стенда лежит в env/<стенд>.env и накладывается ПЕРЕД этим файлом,
# поэтому значение отсюда всегда важнее.

# Какой стенд. Список — lo-order --stand ?
LO_STAND=test12


# --- стенд ------------------------------------------------------------------
# Хосты стенда выводятся из LO_STAND.
# LO_BASE_URL=   LO_PICKER_PROXY_URL=   LO_TMS_URL=


LO_B2B_ORG_PATH=/api-gateway/v1/b2b/legalEntity/person
LO_B2B_ORG_SELECT_PATH=/api-gateway/v1/users/profile/select

# На тестовом окружении домен непринципиален, но должен быть одинаковым везде.
LO_DOMAIN=moscow

# --- пути авторизации -------------------------------------------------------
LO_AUTH_SEND_PATH=/api-gateway/v1/auth/code/send
LO_AUTH_VERIFY_PATH=/api-gateway/v1/auth/code/verify

# --- ключи миссий -----------------------------------------------------------
LO_MPK_DELIVERY=mp200-e86823887bcb4bf397df8c224f1a9dbf
LO_MPK_PICKUP=mp290-be269503c7334818b474f565fc266555

# --- данные стенда ----------------------------------------------------------
LO_PARTNER_DISCOUNT_CARD=

# --- вход -------------------------------------------------------------------
# Пусто = скрипт спросит код в консоли.
LO_SMS_STUB_CODE=1234

# Готовый sessionToken: аварийный обход авторизации. Заполнить, только
# если вход по коду недоступен: снимается из DevTools (кука Utk_SssTkn).
# Протухший здесь токен не ломает прогон — скрипт войдёт по коду заново.
LO_SESSION_TOKEN=
LO_PASSPORT_ID=

# Кэш сессии между запусками — снимает лимит на запрос кода.
LO_TOKEN_CACHE_PATH=.lo_session.json
LO_TOKEN_MAX_AGE=21600

# --- пул тестовых аккаунтов -------------------------------------------------
# Телефон в любом формате — приводится к 7XXXXXXXXXX (как шлёт браузер).
LO_ACCOUNTS=[{"phone":"79431230077","label":"ООО СОЛМИКС КОНСАЛТИНГ"},{"phone":"79430000014","label":"ООО АСТА ПАК"}]

# --- TMS Lite: назначение сборки --------------------------------------------
# Отдельная система (Django-админка): вход по логину и паролю, не по коду.
# Без них lo-order оформит заказ, но назначить сборку не сможет.
LO_TMS_PICKER_MODE=hand
LO_TMS_COURIER_MODE=hand
LO_TMS_TAXI_MODE=auction_now

# --- вывод на смену (picker-service-proxy) ----------------------------------
# TMS назначает заказ только на сотрудников, открывших смену. Если её нет, в
# списках исполнителей остаются одни Dummy — lo-order это заметит и выведет
# сборщика с курьером сам. Логин сотрудника здесь = его Id в списках TMS.
LO_PICKER_CLIENT=android_11_900
LO_PICKER_DEVICE_ID=8888
# Параметры смены: ТК, время окончания, обед (у курьера обеда нет)
LO_WORKSHIFT_RETRY_ATTEMPTS=5

# --- сборка маркированных и партионных позиций ------------------------------
# Товарная группа марки Datamatrix. Полный список — в marking.py
# (milk, beer, shoes, bio_short, tobacco_set, ...).
# Производитель партии. Если такого нет в ответе sapManufacturer,
# берётся первый доступный.
# Дата партии ГГГГ-ММ-ДД. Приоритет сверху вниз: первая заполненная выигрывает.
# Если не задано нигде и в заказе даты нет, сборка остановится и назовёт
# переменную: выдуманную дату SAP отклонит («партия не найдена»).

# 1. Своя каждому SKU — важнее всего
# 2. Всей ветке sapBatchAdd (маркированные партионные, MARK_PEU_BATCH)
# 2. Всей ветке sapBatch (BATCH и MARK_OSU_BATCH)
# 3. Дальше берётся batches[] из самого заказа
# 4. Всем партионным сразу — последний запасной вариант
# Валидация в SAP асинхронная: sapValidate повторяется после каждого чтения
# статуса, пока не придёт SAP_VALIDATING_SUCCESS. В коллекции — 20 чтений
# с паузой 15 секунд.
LO_SAP_VALIDATE_ATTEMPTS=20
LO_SAP_VALIDATE_DELAY=15

# Сервис Goods: у весового товара штрихкод содержит граммовку, а базовый код
# для неё берётся отсюда. Канал — из корня коллекции B2B-Pick; на неверном
# стенд отвечает 400 «<значение> is not valid».
LO_GOODS_URL=goods-app-stage.dev.lenta.tech
LO_GOODS_CHANNEL=CHANNEL_B2B

# Заказ в собственные нужды: партии у партионных товаров не запрашиваются.
# Пусто — определяется по ответам стенда (markOwnNeeds и vetOwnNeeds разом).
# true/false перекрывает то, что сказал стенд.
LO_OWN_NEEDS=

# --- поведение клиента ------------------------------------------------------
LO_CONNECT_TIMEOUT=5
LO_READ_TIMEOUT=30
LO_RETRY_ATTEMPTS=3
LO_ORDER_WAIT_TIMEOUT=60
LO_ORDER_POLL_INTERVAL=2

# Папка логов: на каждый прогон свой файл, который переименовывается в
# «<номер заказа>.log», как только номер известен.
LO_LOG_DIR=logs
# Точный путь к файлу лога. Задан — перекрывает LO_LOG_DIR, имя не меняется.
LO_LOG_FILE=
# Обрезка тел в консоли (в файл они пишутся целиком)
LO_LOG_BODY_LIMIT=2000
