# ЛИЧНЫЕ настройки: свой аккаунт, свой токен, свои логи.
# Образец .env. Сам .env тоже лежит в репозитории: учётки в нём тестовые.
#
# Общее для стенда (учётки сотрудников, магазин, товары) лежит в env/<стенд>.env
# и в репозитории есть: им пользуются все. Этот файл накладывается ПОВЕРХ него,
# поэтому значение отсюда всегда важнее.
#
# Какой стенд. Хосты выводятся из названия, задавать их отдельно не нужно.
# Список заведённых стендов: lo-order --stand ?
LO_STAND=test12

# Организации живут на основном хосте за api-gateway (подтверждено HAR).
# Отдельного хоста b2b-info-*-svc здесь больше нет: путь /front/api/v1/... —
# наследство старого скрипта, на текущем стенде он отдаёт 404 page not found.
LO_B2B_ORG_PATH=/api-gateway/v1/b2b/legalEntity/person
LO_B2B_ORG_SELECT_PATH=/api-gateway/v1/users/profile/select

# Домен на тестовом окружении непринципиален, но одинаков во всех запросах.
LO_DOMAIN=moscow

# --- пути авторизации -------------------------------------------------------
# На стенде send и verify живут по разным префиксам. Если verify отдаёт 404,
# определите верный путь командой:  python -m lo_api.cli.probe_auth
LO_AUTH_SEND_PATH=/api-gateway/v1/auth/code/send
LO_AUTH_VERIFY_PATH=/api-gateway/v1/auth/code/verify

# --- ключи миссий -----------------------------------------------------------
LO_MPK_DELIVERY=mp200-e86823887bcb4bf397df8c224f1a9dbf
LO_MPK_PICKUP=mp290-be269503c7334818b474f565fc266555

# Карта лояльности. ОСТАВЬТЕ ПУСТЫМ: скрипт берёт её у выбранной организации
# (proCardNumber из b2b/legalEntity). Заполняйте только чтобы принудительно
# подставить чужую карту — своя у каждой организации, и прописанная здесь
# сломает прогон под другим аккаунтом.
LO_PARTNER_DISCOUNT_CARD=

# --- вход -------------------------------------------------------------------
# Код входа. На стенде test12 работает 1234 (подтверждено HAR-записью).
# Пусто = скрипт спросит код в консоли.
LO_SMS_STUB_CODE=1234

# Готовый sessionToken: аварийный обход авторизации. ОСТАВЬТЕ ПУСТЫМ —
# в норме токен приходит в ответе verify и кэшируется сам. Заполняйте, только
# если вход по коду недоступен: снимается из DevTools (кука Utk_SssTkn).
# Токен привязан к одному аккаунту, поэтому с пулом аккаунтов не работает.
# Протухший здесь токен не ломает прогон — скрипт войдёт по коду заново.
LO_SESSION_TOKEN=
LO_PASSPORT_ID=

# Кэш сессии между запусками — снимает лимит на запрос кода.
LO_TOKEN_CACHE_PATH=.lo_session.json
LO_TOKEN_MAX_AGE=21600

# --- аккаунты ----------------------------------------------------------------
# При запуске lo-order показывает их списком, последним пунктом — ввод своего
# номера. label виден в меню, чтобы не путать учётки. Телефон в любом формате —
# приводится к 7XXXXXXXXXX. С -y берётся первый из списка.
LO_ACCOUNTS=[{"phone":"79990001122","label":"основной"},{"phone":"79990003344","label":"без организаций"}]

# Режимы переноса в форме расследования:
#   picker:  hand | instant | пусто (не переносить)
#   courier: auto | hand | auto_taxi | hand_taxi | пусто
#   taxi:    auction_now | auction_due | yandex_now | yandex_due
LO_TMS_PICKER_MODE=hand
LO_TMS_COURIER_MODE=hand
LO_TMS_TAXI_MODE=auction_now

LO_PICKER_CLIENT=androin_11_900
LO_PICKER_DEVICE_ID=8888

# Стенд регулярно отдаёт 500 «error proxy» на шагах смены — это его
# нестабильность, а не отказ. Шаги идемпотентны, поэтому повторяются.
LO_WORKSHIFT_RETRY_ATTEMPTS=5

# Валидация в SAP асинхронная: sapValidate повторяется после каждого чтения
# статуса, пока не придёт SAP_VALIDATING_SUCCESS. В коллекции — 20 чтений
# с паузой 15 секунд.
LO_SAP_VALIDATE_ATTEMPTS=20
LO_SAP_VALIDATE_DELAY=15

# Сервис Goods: у весового товара штрихкод содержит граммовку, а базовый код
# для неё берётся отсюда. Канал — из корня коллекции B2B-Pick; на неверном
# стенд отвечает 400 «<значение> is not valid».
LO_GOODS_URL=goods-app-stage.dev.lenta.tech
LO_GOODS_CHANNEL=CHANNEL_B2B

# Заказ в собственные нужды: партии у партионных товаров не запрашиваются.
# Пусто — определяется по ответам стенда (markOwnNeeds и vetOwnNeeds разом).
# true/false перекрывает то, что сказал стенд.
LO_OWN_NEEDS=

# --- поведение клиента ------------------------------------------------------
LO_CONNECT_TIMEOUT=5
LO_READ_TIMEOUT=30
LO_RETRY_ATTEMPTS=3
LO_ORDER_WAIT_TIMEOUT=60
LO_ORDER_POLL_INTERVAL=2

# Папка логов: на каждый прогон свой файл, который переименовывается в
# «<номер заказа>.log», как только номер известен. Пусто — файлы не писать.
LO_LOG_DIR=logs
# Точный путь к файлу лога. Задан — перекрывает LO_LOG_DIR, имя не меняется.
LO_LOG_FILE=
# Обрезка тел в консоли (в файл они пишутся целиком)
LO_LOG_BODY_LIMIT=2000
