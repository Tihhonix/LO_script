# .env и env/*.env лежат в репозитории: все учётки в них тестовые, и настройки
# должны быть под рукой у каждого, кто клонирует проект.
#
# Ручные резервные копии (.env.bak, .env.backup-2323) — мусор, а не настройки:
# в истории они только путали бы, какой файл настоящий.
.env.*
!.env.example

# Кэш сессии — не настройка, а живой токен последнего входа. Меняется каждый
# прогон: в git он давал бы правку в каждом коммите и конфликты между людьми
.lo_session.json

# Ответы последнего заказа для повтора — у каждого свои и меняются каждый раз
.lo_last_order.json

# Логи прогонов: в телах запросов лежат sessionToken и данные аккаунта
*.log

# Снимок проекта до перехода на git — теперь его роль выполняет история
lo-api-tests.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Тесты и отчёты
.pytest_cache/
.ruff_cache/
allure-results/
allure-report/
htmlcov/
.coverage
logs/

# IDE и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db
