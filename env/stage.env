# Настройки стенда stage. Адреса и учётки сотрудников — из окружения
# «Stage Env» коллекции B2B-Pick; TMS, ТК и магазин Goods — как на других
# стендах, на stage не проверены.

# --- адреса стенда ----------------------------------------------------------
# Пишутся одинаково, без https:// — схему скрипт расставит сам.
# <сервис>-stage.dev.lenta.tech. Goods общий для всех стендов.
LO_BASE_URL=lenta-angular-stage.dev.lenta.tech
LO_PICKER_PROXY_URL=picker-service-proxy-stage.dev.lenta.tech
LO_TMS_URL=tms-lite-api-stage.dev.lenta.tech
LO_GOODS_URL=goods-app-stage.dev.lenta.tech

# --- учётки стенда ----------------------------------------------------------
LO_TMS_USER=tms
LO_TMS_PASSWORD=tms-lite
# Учётки сотрудников. Список — чтобы гонять тесты под разными: под какой
# работать, спрашивается при выводе на смену либо задаётся флагом --picker.
# Логин здесь — это же Id сотрудника в списках TMS.
LO_PICKERS=[{"login":"95170811","password":"12345","label":"сборщик stage"}]
LO_COURIERS=[{"login":"95130308","password":"12345","label":"курьер stage"}]
LO_MP_PICKER_ID=50
LO_MP_PICKER_KEY=mp50-5332b7f24ba54351047601d78f90dafbfd7fcc295f966d3af19aeb

# --- магазин и смена --------------------------------------------------------
# Номер ТК в пути Goods: по нему генератор марок ищет штрихкод товара.
LO_GOODS_STORE_ID=12
# Магазин самовывоза не задан: список приходит со стенда при оформлении.
# LO_PICKUP_STORE_ID=
LO_WORKSHIFT_TK=43
LO_WORKSHIFT_END=23:00
LO_WORKSHIFT_LUNCH=20:30-21:00

# --- товары стенда ----------------------------------------------------------
# Товаров stage в коллекции нет: заполните по мере появления.
LO_SKUS=[]
LO_ORDER_ITEMS=
LO_BATCH_DATES={}
LO_MARKING_TYPE=milk
LO_PREFERRED_MANUFACTURER=ПП для Ленты
LO_BATCH_DATE_ADD=
LO_BATCH_DATE_SAP=
LO_BATCH_DATE=
