# Образец настроек стенда. Скопируйте в env/<стенд>.env и заполните:
#     cp env/stand.env.example env/stage.env
# Пустое значение у списка, словаря или числа не разбирается: пишите [] и {},
# а ненужные числовые переменные закомментируйте.

# --- адреса стенда ----------------------------------------------------------
# Пишутся одинаково, без https:// — схему скрипт расставит сам.
# Если строку убрать, адрес выведется из названия стенда по шаблону
# <сервис>-<имя стенда>.dev.lenta.tech. Goods общий для всех стендов.
# Проще всего эти четыре строки удалить — тогда адреса выведутся сами.
LO_BASE_URL=lenta-angular-<стенд>.dev.lenta.tech
LO_PICKER_PROXY_URL=picker-service-proxy-<стенд>.dev.lenta.tech
LO_TMS_URL=tms-lite-api-<стенд>.dev.lenta.tech
LO_GOODS_URL=goods-app-stage.dev.lenta.tech

# --- учётки стенда ----------------------------------------------------------
LO_TMS_USER=
LO_TMS_PASSWORD=
# Учётки сотрудников. Список — чтобы гонять тесты под разными учётками:
# под какой работать, спрашивается при выводе на смену.
# Логин — это же Id сотрудника в списках TMS.
LO_PICKERS=[{"login":"","password":"","label":""}]
LO_COURIERS=[{"login":"","password":"","label":""}]
LO_MP_PICKER_ID=50
LO_MP_PICKER_KEY=

# --- магазин и смена --------------------------------------------------------
# LO_PICKUP_STORE_ID=   # необязателен: список магазинов приходит со стенда
# Номер ТК в пути Goods: по нему генератор марок ищет штрихкод товара
LO_GOODS_STORE_ID=12
LO_WORKSHIFT_TK=
LO_WORKSHIFT_END=
LO_WORKSHIFT_LUNCH=

# --- товары стенда ----------------------------------------------------------
LO_SKUS=[]
LO_ORDER_ITEMS=
LO_BATCH_DATES={}
LO_MARKING_TYPE=
LO_PREFERRED_MANUFACTURER=
LO_BATCH_DATE_ADD=
LO_BATCH_DATE_SAP=
LO_BATCH_DATE=
