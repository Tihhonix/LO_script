# --- адреса стенда ----------------------------------------------------------
# Пишутся одинаково, без https:// — схему скрипт расставит сам.
# Если строку убрать, адрес выведется из названия стенда по шаблону
# <сервис>-test12.dev.lenta.tech. Goods общий для всех стендов.
LO_BASE_URL=lenta-angular-test12.dev.lenta.tech
LO_PICKER_PROXY_URL=picker-service-proxy-test12.dev.lenta.tech
LO_TMS_URL=tms-lite-api-test12.dev.lenta.tech
LO_GOODS_URL=goods-app-stage.dev.lenta.tech

# --- учётки стенда ----------------------------------------------------------
LO_TMS_USER=tms
LO_TMS_PASSWORD=tms-lite
# Учётки сотрудников. Список — чтобы гонять тесты под разными: под какой
# работать, спрашивается при выводе на смену либо задаётся флагом --picker.
# Логин здесь — это же Id сотрудника в списках TMS.
LO_PICKERS=[{"login":"95372156","password":"84294","label":"Пикерок БиТуБи"}]
LO_COURIERS=[{"login":"95372157","password":"29258","label":"Курок БиТуБи"}]
